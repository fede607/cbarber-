# Base de datos (Neon). DATABASE_URL = conexión "pooled"; DIRECT_URL = conexión directa (migraciones).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.eu-central-1.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.eu-central-1.aws.neon.tech/DB?sslmode=require"

# Auth.js — genera uno con: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# URL pública sin barra final (se usa en los enlaces de los emails)
APP_URL="https://tudominio.es"

# Usuario administrador inicial (solo lo usa `npm run db:seed`)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Protege /api/cron/* — genera uno con: openssl rand -hex 32
CRON_SECRET=""

# Resend. Sin clave, los emails no se envían: quedan registrados en el panel como "no configurado".
RESEND_API_KEY=""
EMAIL_FROM="Barbería Carlos <reservas@tudominio.es>"
# Opcional: aviso a Carlos por cada reserva nueva, cambio o cancelación
ADMIN_NOTIFY_EMAIL=""

# Opcional: horas de antelación con las que se envía el recordatorio (36 con cron diario, 24 con cron horario)
REMINDER_WINDOW_HOURS="36"
# Opcional: meses sin citas tras los que se anonimizan los datos de un cliente
RETENTION_MONTHS="24"

# Opcional: subida de imágenes desde el panel (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""
